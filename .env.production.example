# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN - LA BRECHA
# ===========================================

# Base de datos (PostgreSQL)
DB_NAME=labrecha
DB_USERNAME=labrecha
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI

# CORS: orígenes permitidos para la API
CORS_ALLOWED_ORIGINS=https://labrecha.ar,https://www.labrecha.ar,http://localhost:3000

# Frontend → FastAPI (interno, server-side; el frontend proxya /api/data hacia acá)
LABRECHA_API_INTERNAL_URL=http://api-py:8000

# Google Analytics (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# INSTRUCCIONES:
# 1. Copiar este archivo a .env
# 2. Reemplazar los valores con datos reales
# 3. NUNCA commitear el archivo .env a git
# ===========================================
